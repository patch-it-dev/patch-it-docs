{
  "name": "patch-it dark",
  "type": "dark",
  "colors": {
    "editor.background": "#12161C",
    "editor.foreground": "#E9EBEE",
    "editorLineNumber.foreground": "#868F9B",
    "editorCursor.foreground": "#6F86FF",
    "editor.selectionBackground": "#2A3354",
    "diffEditor.insertedTextBackground": "#10241A",
    "diffEditor.removedTextBackground": "#2C1517",
    "terminal.ansiBlue": "#6F86FF",
    "terminal.ansiBrightBlue": "#6F86FF",
    "terminal.ansiGreen": "#3FB950",
    "terminal.ansiRed": "#F47067",
    "terminal.ansiYellow": "#D4A72C",
    "terminal.ansiBrightBlack": "#868F9B"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#868F9B",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#8A9CFF"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#E8C27D"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant"
      ],
      "settings": {
        "foreground": "#F0A97A"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#F5F0E6"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#B9C4FF"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#E9EBEE"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#9BA3AD"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#B9C4FF"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#3FB950"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#F47067"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#D4A72C"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#8A9CFF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#8A9CFF",
        "fontStyle": "underline"
      }
    }
  ]
}